<?xml version="1.0"?>
<Container version="2">
  <Name>curacast</Name>
  <Repository>curacast/curacast:latest-nvidia</Repository>
  <Registry>https://hub.docker.com/r/curacast/curacast</Registry>
  <Network>host</Network>
  <MyIP/>
  <Shell>bash</Shell>
  <Privileged>false</Privileged>
  <Support>https://curacast.tv/support</Support>
  <Project>https://curacast.tv</Project>
  <Overview>Curacast turns your Plex, Jellyfin or Emby library into always-on live TV channels with a real schedule and programme guide. It appears to Plex as an HDHomeRun tuner, and serves M3U and XMLTV for any IPTV client.&#xD;
&#xD;
Channels are managed from the Curacast web UI on port 8000. FFmpeg is bundled in the image.&#xD;
&#xD;
Licensing: the free tier covers 2 channels. A subscription removes the limit. Existing channels are never removed if a licence lapses.</Overview>
  <Category>MediaApp:Video</Category>
  <WebUI>http://[IP]:[PORT:8000]</WebUI>
  <TemplateURL/>
  <Icon>https://curacast.tv/icon.png</Icon>
  <ExtraParams>--runtime=nvidia</ExtraParams>
  <PostArgs/>
  <CPUset/>
  <DateInstalled>1589436589</DateInstalled>
  <DonateText/>
  <DonateLink/>
  <Description>Curacast turns your Plex, Jellyfin or Emby library into always-on live TV channels with a real schedule and programme guide. It appears to Plex as an HDHomeRun tuner, and serves M3U and XMLTV for any IPTV client.&#xD;
&#xD;
Channels are managed from the Curacast web UI on port 8000. FFmpeg is bundled in the image.&#xD;
&#xD;
Licensing: the free tier covers 2 channels. A subscription removes the limit. Existing channels are never removed if a licence lapses.</Description>
  <Networking>
    <Mode>host</Mode>
    <Publish>
      <Port>
        <HostPort>8000</HostPort>
        <ContainerPort>8000</ContainerPort>
        <Protocol>tcp</Protocol>
      </Port>
    </Publish>
  </Networking>
  <Data>
    <Volume>
      <HostDir>/mnt/user/appdata/curacast/</HostDir>
      <ContainerDir>/home/curacast/app/.curacast</ContainerDir>
      <Mode>rw</Mode>
    </Volume>
  </Data>
  <Environment>
    <Variable>
      <Value>all</Value>
      <Name>NVIDIA_VISIBLE_DEVICES</Name>
      <Mode/>
    </Variable>
    <Variable>
      <Value>all</Value>
      <Name>NVIDIA_DRIVER_CAPABILITIES</Name>
      <Mode/>
    </Variable>
  </Environment>
  <Labels/>
  <Config Name="Webui &amp;amp; HDHR" Target="8000" Default="" Mode="tcp" Description="Container Port: 8000" Type="Port" Display="always" Required="false" Mask="false">8000</Config>
  <Config Name="NVIDIA_VISIBLE_DEVICES" Target="NVIDIA_VISIBLE_DEVICES" Default="" Mode="" Description="Container Variable: NVIDIA_VISIBLE_DEVICES" Type="Variable" Display="always" Required="false" Mask="false">all</Config>
  <Config Name="NVIDIA_DRIVER_CAPABILITIES" Target="NVIDIA_DRIVER_CAPABILITIES" Default="" Mode="" Description="Container Variable: NVIDIA_DRIVER_CAPABILITIES" Type="Variable" Display="always" Required="false" Mask="false">all</Config>
  <Config Name="Appdata" Target="/home/curacast/app/.curacast" Default="" Mode="rw" Description="Container Path: /home/curacast/app/.curacast" Type="Path" Display="always" Required="false" Mask="false">/mnt/user/appdata/curacast/</Config>
</Container>
